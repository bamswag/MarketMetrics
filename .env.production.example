# Runtime mode. Production mode requires DATABASE_URL and a secure JWT_SECRET.
APP_ENV=production

# Private PostgreSQL service on the OVH Docker network. Generate one password
# with `openssl rand -hex 32`, use it in both values, and never expose port 5432.
DATABASE_URL=postgresql://marketmetrics:replace-with-a-random-secret@db:5432/marketmetrics
POSTGRES_DB=marketmetrics
POSTGRES_USER=marketmetrics
POSTGRES_PASSWORD=replace-with-a-random-secret

# Optional temporary rollback source after a managed-database migration.
# Remove it after the rollback window and backup validation are complete.
NEON_DATABASE_URL=

# Generate a new value; do not reuse a value exposed in source control.
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
APP_LOG_LEVEL=INFO
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# During the IP-only test, avoid authentication and email-link workflows.
# Set both URLs to https://marketmetrics.dev during the final cutover.
FRONTEND_BASE_URL=https://marketmetrics.dev
ADDITIONAL_FRONTEND_ORIGINS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://marketmetrics.dev/auth/google/callback

BREVO_API_KEY=
BREVO_TRANSACTIONAL_EMAIL_URL=https://api.brevo.com/v3/smtp/email
BREVO_TIMEOUT_SECONDS=20
EMAIL_FROM_NAME=MarketMetrics
EMAIL_FROM_ADDRESS=

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
MARKET_DATA_DEFAULT_HISTORY_DAYS=3650

SYMBOL_CATALOG_PATH=data/symbol_catalog.json
PREDICTION_MODEL_DIR=artifacts/prediction
PREDICTION_TRAINING_LOOKBACK_DAYS=1825
PREDICTION_FETCH_CONCURRENCY=5
PREDICTION_TRAINING_UNIVERSE=
PREDICTION_TRAINING_UNIVERSE_PATH=data/training_universe.json
